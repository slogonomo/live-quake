+/* Count display glyphs without reading beyond the current message. */
+static int SCR_CenterPrintGlyphCount (void)
+{
+	int i, glyphs = 0;
+
+	for (i = 0; i < (int) sizeof (scr_centerstring); i++)
+	{
+		if (!scr_centerstring[i])
+			return glyphs;
+		if (scr_centerstring[i] != '\n')
+			glyphs++;
+	}
+	return -1;
+}
+
+/* The existing printer draws one glyph before consuming its time budget. */
+static int SCR_CenterPrintRevealCount (int glyphs)
+{
+	double elapsed = cl.time - scr_centertime_start;
+	double budget;
+
+	if (glyphs <= 0 || !isfinite (elapsed) || elapsed < 0 || !isfinite (scr_printspeed.value))
+		return 0;
+	budget = scr_printspeed.value * elapsed;
+	if (!isfinite (budget))
+		return 0;
+	if (budget <= -1 || budget >= glyphs - 1)
+		return glyphs;
+	return (int) budget + 1;
+}
+
+qboolean SCR_FinaleFinished (void)
+{
+	int glyphs;
+
+	if (cls.state != ca_connected || cl.intermission != 2)
+		return false;
+	glyphs = SCR_CenterPrintGlyphCount ();
+	return glyphs > 0 && SCR_CenterPrintRevealCount (glyphs) == glyphs;
+}
