+static char lq_userdir[MAX_OSPATH];
+
+/* The native frontend supplies an existing private profile. Do not infer a
+ * real user's HOME or create the normal Ironwail user directory. */
+static int Sys_LQReadProfile (const char *path)
+{
+	const char *part, *slash;
+	char component[256];
+	struct stat st;
+	int fd, next, ok = 0;
+	size_t length;
+
+	if (!path || path[0] != '/' || !path[1] ||
+		strlen (path) >= sizeof (lq_userdir) - 64 || strchr (path, '\\'))
+		return 0;
+	for (part = path; *part; part++)
+		if ((unsigned char)*part < 32 || (unsigned char)*part == 127)
+			return 0;
+	fd = open ("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0)
+		return 0;
+	for (part = path + 1; *part; part = slash + 1)
+	{
+		slash = strchr (part, '/');
+		length = slash ? (size_t)(slash - part) : strlen (part);
+		if (!length || length >= sizeof (component) ||
+			(length == 1 && part[0] == '.') ||
+			(length == 2 && part[0] == '.' && part[1] == '.'))
+			goto done;
+		memcpy (component, part, length);
+		component[length] = 0;
+		next = openat (fd, component, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+		if (next < 0)
+			goto done;
+		close (fd);
+		fd = next;
+		if (!slash)
+			break;
+		if (!slash[1])
+			goto done;
+	}
+	if (fstat (fd, &st) || !S_ISDIR (st.st_mode) || st.st_uid != getuid () ||
+		(st.st_mode & 0777) != 0700)
+		goto done;
+	memcpy (lq_userdir, path, strlen (path) + 1);
+	ok = 1;
+done:
+	close (fd);
+	return ok;
+}
+#endif
