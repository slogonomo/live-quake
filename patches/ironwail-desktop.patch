+/* QC entity values are byte offsets, not arbitrary addresses. Validate the
+ * exact slot and field payload before forming any typed pointer. Free slots
+ * inside num_edicts remain valid; allocation/lifecycle policy is unchanged. */
+static eval_t *PR_EntityField (int entity, int field, int width, qboolean writing)
+{
+	size_t offset;
+	if (entity < 0 || qcvm->edict_size <= 0 || !qcvm->edicts ||
+		entity % qcvm->edict_size || entity / qcvm->edict_size >= qcvm->num_edicts ||
+		field < 0 || qcvm->progs->entityfields < width ||
+		field > qcvm->progs->entityfields - width)
+		PR_RunError ("invalid entity field access");
+	if (writing && entity == 0 && sv.state == ss_active)
+		PR_RunError ("assignment to world entity");
+	offset = offsetof(edict_t, v) + (size_t)field * sizeof(float);
+	if (offset > (size_t)qcvm->edict_size ||
+		(size_t)width * sizeof(float) > (size_t)qcvm->edict_size - offset ||
+		(size_t)entity + offset > INT_MAX)
+		PR_RunError ("invalid entity field span");
+	return (eval_t *)((byte *)qcvm->edicts + (size_t)entity + offset);
+}
+
+static eval_t *PR_EntityPointer (int pointer, int width)
+{
+	int entity;
+	size_t within, fieldbytes;
+	if (pointer < 0 || qcvm->edict_size <= 0 || !qcvm->edicts)
+		PR_RunError ("invalid entity pointer");
+	entity = pointer / qcvm->edict_size;
+	within = pointer % qcvm->edict_size;
+	if (entity >= qcvm->num_edicts || within < offsetof(edict_t, v))
+		PR_RunError ("entity pointer outside field payload");
+	fieldbytes = within - offsetof(edict_t, v);
+	if (fieldbytes % sizeof(float) || qcvm->progs->entityfields < width ||
+		fieldbytes / sizeof(float) > (size_t)(qcvm->progs->entityfields - width) ||
+		(size_t)width * sizeof(float) > (size_t)qcvm->edict_size - within)
+		PR_RunError ("invalid entity pointer field span");
+	if (entity == 0 && sv.state == ss_active)
+		PR_RunError ("assignment to world entity");
+	return (eval_t *)((byte *)qcvm->edicts + pointer);
