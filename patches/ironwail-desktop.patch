+/* Validate backed file ranges before constructing typed lump pointers or
+ * endian-walking attacker-controlled counts. Subtraction avoids overflow. */
+static qboolean PR_LumpFits (int offset, int count, size_t width, size_t alignment, size_t bytes)
+{
+	return offset >= 0 && count >= 0 && (size_t)offset <= bytes &&
+		(!count || (size_t)offset >= sizeof(dprograms_t)) &&
+		(size_t)offset % alignment == 0 &&
+		(size_t)count <= (bytes - (size_t)offset) / width;
+}
+
+static qboolean PR_RejectProgs (const char *filename, qboolean fatal, const char *reason)
+{
+	// Also preserve optional simple-CSQC rejection/fallback, not a fatal load.
+	if (fatal)
+		Host_Error ("%s: %s", filename, reason);
+	Con_Printf ("%s: %s\n", filename, reason);
+	qcvm->progs = NULL;
+	return false;
+}
+
+static qboolean PR_FunctionMetadataValid (const dfunction_t *f, qboolean interpreted)
+{
+	int i, words = 0;
+	// Builtin dispatch never reads signature/local metadata, including varargs
+	// declarations. Defer #0 declarations until remapping identifies the target.
+	if (!interpreted)
+		return true;
+	if (f->numparms > MAX_PARMS)
+		return false;
+	for (i = 0; i < f->numparms; i++)
+	{
+		if (f->parm_size[i] > 3)
+			return false;
+		words += f->parm_size[i];
+	}
+	if (f->locals < 0 || f->parm_start < 0 || f->parm_start > qcvm->progs->numglobals)
+		return false;
+	return f->locals <= qcvm->progs->numglobals - f->parm_start &&
+		words <= qcvm->progs->numglobals - f->parm_start;
+
