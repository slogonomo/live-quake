+static char *LQ_ReadCheckpoint (const char *path, int *count, const char **body_end)
+{
+	struct stat before, after;
+	char *text = NULL;
+	FILE *file;
+	int fd, ok;
+	fd = open (path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+	if (fd < 0)
+		return NULL;
+	if (fstat (fd, &before) || !S_ISREG (before.st_mode) || before.st_uid != getuid () ||
+		before.st_size < 100 || before.st_size >= LQ_SAVE_MAX_BYTES)
+	{
+		close (fd);
+		return NULL;
+	}
+	file = fdopen (fd, "rb");
+	if (!file)
+	{
+		close (fd);
+		return NULL;
+	}
+	text = (char *)malloc ((size_t)before.st_size + 1);
+	ok = text && fread (text, 1, (size_t)before.st_size, file) == (size_t)before.st_size &&
+		fgetc (file) == EOF && !ferror (file) && !fstat (fd, &after) &&
+		before.st_dev == after.st_dev && before.st_ino == after.st_ino &&
+		before.st_size == after.st_size;
+	if (fclose (file) != 0)
+		ok = 0;
+	if (ok)
+	{
+		text[before.st_size] = 0;
+		ok = LQ_SaveFooter (text, (size_t)before.st_size, count, body_end);
+	}
+	if (!ok)
+	{
+		free (text);
+		return NULL;
+	}
+	return text;
+}
+
+/* Refuse aliases and foreign files before truncating an owned checkpoint.
+ * Walk parents by descriptor so even a symlinked gamedir cannot escape the
+ * frontend's private profile. Same-uid concurrent mutation is not prevented. */
+static FILE *LQ_OpenCheckpoint (const char *path)
+{
+	const char *part, *slash;
+	char component[256];
+	struct stat st;
+	FILE *file = NULL;
+	int parent, next, fd = -1;
+	size_t length;
+	if (!path || path[0] != '/' || !path[1] || strlen (path) >= MAX_OSPATH || strchr (path, '\\'))
+		return NULL;
+	for (part = path; *part; ++part)
+		if ((unsigned char)*part < 32 || (unsigned char)*part == 127)
+			return NULL;
+	parent = open ("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+	if (parent < 0)
+		return NULL;
+	for (part = path + 1;; part = slash + 1)
+	{
+		slash = strchr (part, '/');
+		length = slash ? (size_t)(slash - part) : strlen (part);
+		if (!length || length >= sizeof (component) ||
+			(length == 1 && part[0] == '.') ||
+			(length == 2 && part[0] == '.' && part[1] == '.'))
+			goto done;
+		memcpy (component, part, length);
+		component[length] = 0;
+		if (!slash)
+			break;
+		next = openat (parent, component, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+		if (next < 0)
+			goto done;
+		close (parent);
+		parent = next;
+	}
+	if (fstat (parent, &st) || !S_ISDIR (st.st_mode) || st.st_uid != getuid () ||
+		(st.st_mode & 0777) != 0700)
+		goto done;
+	fd = openat (parent, component, O_WRONLY | O_CREAT | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK, 0600);
+	if (fd < 0 || fstat (fd, &st) || !S_ISREG (st.st_mode) || st.st_uid != getuid () ||
+		(st.st_mode & 0777) != 0600 || st.st_nlink != 1)
+		goto done;
+	file = fdopen (fd, "w");
+	if (!file)
+		goto done;
+	fd = -1; // file now owns the descriptor
+	if (ftruncate (fileno (file), 0))
+	{
+		fclose (file);
+		file = NULL;
+	}
+done:
+	if (fd >= 0)
+		close (fd);
+	close (parent);
+	return file;
+}
+
+static int LQ_SaveLine (const char **data, const char *end, const char **line, size_t *length)
+{
+	const char *newline;
+	if (*data >= end || !(newline = (const char *)memchr (*data, '\n', (size_t)(end - *data))) ||
+		(size_t)(newline - *data) >= 1024)
+		return 0;
+	*line = *data;
+	*length = (size_t)(newline - *data);
+	*data = newline + 1;
+	return 1;
+}
+
+static int LQ_SaveNumber (const char **data, const char *end, double *value)
+{
+	const char *line;
+	char *tail;
+	size_t length;
+	if (!LQ_SaveLine (data, end, &line, &length))
+		return 0;
+	errno = 0;
+	*value = strtod (line, &tail);
+	if (tail == line || errno == ERANGE || !isfinite (*value))
+		return 0;
+	while (tail < line + length && (*tail == ' ' || *tail == '\t' || *tail == '\r'))
+		++tail;
+	return tail == line + length;
+}
+
+static int LQ_SaveHeader (const char *start, const char *end, float *spawn_parms,
+	int *skill, char *mapname, size_t mapsize, double *time,
+	const char **styles, const char **body)
+{
+	const char *data = start, *line;
+	size_t length;
+	double value;
+	int i;
+	if (!LQ_SaveNumber (&data, end, &value) || value != SAVEGAME_VERSION ||
+		!LQ_SaveLine (&data, end, &line, &length))
+		return 0;
+	for (i = 0; i < NUM_SPAWN_PARMS; ++i)
+	{
+		if (!LQ_SaveNumber (&data, end, &value) || value < -FLT_MAX || value > FLT_MAX)
+			return 0;
+		spawn_parms[i] = (float)value;
+	}
+	if (!LQ_SaveNumber (&data, end, &value) || value < 0 || value > 3)
+		return 0;
+	*skill = (int)(value + 0.1); // retain ordinary Quake 1.06 skill compatibility
+	if (!LQ_SaveLine (&data, end, &line, &length) || !length || length >= mapsize ||
+		strspn (line, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-") != length)
+		return 0;
+	memcpy (mapname, line, length);
+	mapname[length] = 0;
+	if (!LQ_SaveNumber (&data, end, time) || *time < 0)
+		return 0;
+	*styles = data;
+	for (i = 0; i < MAX_LIGHTSTYLES; ++i)
+		if (!LQ_SaveLine (&data, end, &line, &length))
+			return 0;
+	*body = data;
+	return 1;
+}
+
+static int LQ_SaveTrailingSpace (const char *data, const char *end)
+{
+	if (!data || data > end)
+		return 0;
+	for (; data < end; ++data)
+		if (*data != ' ' && *data != '\t' && *data != '\r' && *data != '\n')
+			return 0;
+	return 1;
+}
+
+static int LQ_SaveBody (const char *data, const char *end, int count)
+{
+	int i;
+	for (i = -1; i < count; ++i) // globals followed by precisely count entities
+	{
+		data = COM_Parse (data);
+		if (!data || strcmp (com_token, "{"))
+			return 0;
+		for (;;)
+		{
+			data = COM_Parse (data);
+			if (!data)
+				return 0;
+			if (!strcmp (com_token, "}"))
+				break;
+			data = COM_Parse (data);
+			if (!data || !strcmp (com_token, "}"))
+				return 0;
+		}
+	}
+	return LQ_SaveTrailingSpace (data, end);
+}
